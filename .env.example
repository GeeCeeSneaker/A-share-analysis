# Copy to .env and fill with real credentials.
# Real .env is gitignored and must NEVER be committed or logged.
#
# TGW = China Galaxy "GeWu" platform; AmazingData = its Python SDK layer.
# Server details come from your TGW account sheet.
TGW_USERNAME=
TGW_PASSWORD=
# Access server (hosted-colocation mode; from your TGW account sheet)
TGW_SERVER_VIP=
TGW_SERVER_PORT=8000
# Python SDK importable module name (verified: import AmazingData)
TGW_MODULE=AmazingData
