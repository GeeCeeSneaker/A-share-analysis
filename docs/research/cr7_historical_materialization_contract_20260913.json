  },
  "acceptance_gates": [
    {
      "id": "HM-INPUT-01",
      "requirement": "one_verified_readmodel_snapshot_and_complete_lineage",
      "status": "DESIGN_ONLY_NOT_RUN"
    },
    {
      "id": "HM-PARTITION-02",
      "requirement": "split_local_monthly_partition_plan_and_exact_inventory",
      "status": "OFFLINE_TEST_REQUIRED"
    },
    {
      "id": "HM-COVERAGE-03",
      "requirement": "coverage_state_is_explicit_and_aggregate_is_fail_closed",
      "status": "OFFLINE_TEST_REQUIRED"
    },
    {
      "id": "HM-REPLAY-04",
      "requirement": "same_identity_is_idempotent_and_conflict_never_overwrites",
      "status": "OFFLINE_TEST_REQUIRED"
    },
    {
      "id": "HM-ATOMIC-05",
      "requirement": "staging_failure_cannot_publish_a_partial_dataset",
      "status": "DESIGN_ONLY_NOT_RUN"
    },
    {
      "id": "HM-EVIDENCE-06",
      "requirement": "manifest_inventory_partition_hash_and_schema_evidence_are_recomputable",
      "status": "OFFLINE_TEST_REQUIRED"
    },
    {
      "id": "HM-SCOPE-07",
      "requirement": "no_provider_formal_backfill_index_feature_or_strategy_execution",
      "status": "DESIGN_ONLY_NOT_RUN"
    }
  ],
  "global_invariants": [
    "this_contract_is_design_and_offline_preflight_only",
    "no_provider_call_or_historical_materialization_execution_is_authorized_by_this_file",
    "ordinary_research_reads_never_include_disabled_or_unresolved_rows",
    "bse_mapping_is_not_activated_and_bse_rows_remain_disabled",
    "holdout_is_not_implicitly_mixed_into_development",
    "observed_daily_bar_universe_is_not_all_a_shares",
    "raw_unadjusted_price_basis_is_not_adjusted_or_total_return",
    "missing_data_is_not_a_zero_or_negative_event",
    "historical_artifacts_are_append_only_and_never_last_write_wins",
    "credentials_endpoints_tokens_cookies_and_raw_provider_payloads_stay_out_of_github"
  ]
}
