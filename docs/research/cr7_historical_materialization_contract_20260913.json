{
  "contract_id": "cr7-historical-materialization-v1",
  "contract_version": "cr7-history-materialization-v1",
  "base_main_commit": "53257c36e8ada5576f5d2dfce0947710ee24694c",
  "status": "DESIGN_ONLY_NOT_ACTIVE",
  "decision": "DESIGN_PRECHECK_ONLY",
  "target_dataset": "research_security_daily",
  "target_window": {
    "start": "2020-01-01",
    "end": "2026-06-30",
    "inclusive": true,
    "pre_window_data": "WARMUP_OR_PIT_ONLY_NOT_A_RESEARCH_PARTITION"
  },
  "research_splits": {
    "development": {
      "start": "2020-01-01",
      "end": "2023-12-31",
      "inclusive": true,
      "purpose": "exploration_and_rule_development"
    },
    "validation_a": {
      "start": "2024-01-01",
      "end": "2025-12-31",
      "inclusive": true,
      "purpose": "validation_of_development_findings"
    },
    "holdout": {
      "start": "2026-01-01",
      "end": "2026-06-30",
      "inclusive": true,
      "purpose": "final_independent_check_only"
    }
  },
  "authorization": {
    "materialization_execution_authorized": false,
    "provider_calls_authorized": false,
    "production_authorized": false,
    "formal_run_authorized": false,
    "backfill_authorized": false,
    "resume_authorized": false,
    "runtime_policy_changed": false,
    "index_activation_authorized": false,
    "cr5_feature_export_authorized": false,
    "golden_h1_baseline_changes_authorized": false,
    "strategy_work_authorized": false
  },
  "input_contract": {
    "required_entrypoint": "ResearchPanelBuilder.build_from_readmodel",
    "source_kind": "VERIFIED_CR4_READMODEL",
    "source_readmodel_contract_version": "readmodel-v1",
    "single_snapshot_rule": "ONE_VERIFIED_READMODEL_SNAPSHOT_PER_MATERIALIZATION",
    "required_source_provenance": [
      "source_snapshot_id",
      "source_snapshot_as_of",
      "source_snapshot_manifest_hash",
      "source_snapshot_semantic_hash",
      "source_canonical_run_id",
      "source_readmodel_contract_version",
      "identity_view_version",
      "identity_view_hash",
      "identity_source_kind",
      "identity_source_lineage_hash"
    ],
    "identity_rule": "symbol_and_exchange_must_be_replayed_from_the_verified_versioned_security_master_join",
    "pit_rule": "every_consumed_row_available_at_must_be_at_or_before_the_materialization_as_of",
    "selection_rule": "verify_snapshot_and_readmodel_integrity_before_row_selection_or_partitioning",
    "forbidden_inputs": [
      "direct_provider_calls",
      "provider_credentials_or_sdk",
      "raw_provider_payload_as_a_replacement_for_readmodel",
      "caller_claimed_snapshot_hashes",
      "symbol_or_exchange_inference_from_security_id",
      "implicit_multi_snapshot_union",
      "current_code_list_as_historical_trading_truth"
    ]
  },
  "eligibility_contract": {
    "row_granularity": [
      "trade_date",
      "security_id"
    ],
    "primary_key_rule": "exactly_one_row_per_trade_date_and_security_id_within_the_selected_source_snapshot",
    "enabled_route": "research_enabled_partition",
    "disabled_route": "disabled_partition",
    "experimental_route": "experimental_partition_or_explicitly_disabled_artifact",
    "unresolved_rule": "retain_the_row_and_lineage_but_never_promote_unknown_semantics_to_research_enabled",
    "bse_rule": {
      "state": "UNRESOLVED_NOT_FOR_RESEARCH",
      "eligibility": "RESEARCH_DISABLED_UNRESOLVED",
      "reason": "bse_identity_boundary_unresolved",
      "policy": "DISABLE_ALL_BSE_ROWS_IN_R1",
      "mapping_activation": "requires_a_separately_reviewed_identity_continuity_artifact"
    },
    "out_of_window_rule": "rows_before_2020_or_after_2026-06-30_are_not_materialized_as_research_partitions",
    "missing_value_rule": "unknown_is_not_replaced_with_zero_or_a_synthetic_identity"
  },
  "partition_contract": {
    "physical_format": "immutable_parquet",
    "logical_partition_key": [
      "research_split",
      "calendar_year",
      "calendar_month"
    ],
    "physical_artifact_key": [
      "research_route",
      "research_split",
      "calendar_year",
      "calendar_month"
    ],
    "research_route_values": [
      "research_enabled",
      "disabled",
      "experimental"
    ],
    "partition_date_rule": "trade_date_is_inclusive_and_must_fall_inside_the_declared_split",
    "split_mixing": "forbidden",
    "enabled_partition_path_template": "research_security_daily/contract=cr7-history-materialization-v1/materialization=<materialization_id>/route=research_enabled/split=<split>/year=<YYYY>/month=<MM>/data.parquet",
    "disabled_partition_path_template": "research_security_daily/contract=cr7-history-materialization-v1/materialization=<materialization_id>/route=disabled/split=<split>/year=<YYYY>/month=<MM>/data.parquet",
    "experimental_partition_path_template": "research_security_daily/contract=cr7-history-materialization-v1/materialization=<materialization_id>/route=experimental/split=<split>/year=<YYYY>/month=<MM>/data.parquet",
    "expected_logical_partition_count": 78,
    "expected_logical_partition_count_calculation": "48_development_months_plus_24_validation_a_months_plus_6_holdout_months",
    "route_artifact_rule": "each_logical_calendar_partition_has_a_nested_route_inventory; all_route_counts_and_coverage_states_are_explicit; route_artifacts_are_separately_hash_checked_and_a_zero_count_route_must_not_be_inferred_as_zero_market_activity",
    "empty_partition_rule": "every_expected_logical_calendar_partition_has_an_inventory_entry; an_empty_partition_is_not_evidence_of_zero_market_activity",
    "sort_order": [
      "trade_date",
      "security_id",
      "source_canonical_key"
    ],
    "duplicate_rule": "duplicate_primary_keys_or_duplicate_partition_inventory_keys_fail_closed"
  },
  "coverage_contract": {
    "allowed_states": [
      "OBSERVED_DAILY_BAR_COVERAGE",
      "PARTIAL_OBSERVED_DAILY_BAR_COVERAGE",
      "UNRESOLVED_NOT_FOR_RESEARCH"
    ],
    "state_precedence_from_best_to_worst": [
      "OBSERVED_DAILY_BAR_COVERAGE",
      "PARTIAL_OBSERVED_DAILY_BAR_COVERAGE",
      "UNRESOLVED_NOT_FOR_RESEARCH"
    ],
    "partition_state_rule": {
      "observed": "the_verified_input_scope and its integrity evidence cover the partition; counts describe observed daily-bar rows only",
      "partial": "the partition is readable but the verified input scope is explicitly incomplete or only partial",
      "unresolved": "coverage, identity, date applicability, or source integrity cannot be established without inference"
    },
    "route_scope_rule": "coverage_is_aggregated_separately_for_each_route; disabled_or_experimental_diagnostics_do_not_downgrade_the_enabled_route_state",
    "dataset_aggregation_rule": "the_enabled_route_materialization_state_is_the_worst_state_among_enabled_route_partitions; diagnostic_route_states_are_reported_separately",
    "missing_row_semantics": "a_missing_bar_is_not_converted_to_a_zero_return_down_move_non_event_or_negative_event",
    "denominator_semantics": "all_counts_and_cross_sectional_denominators_are_observed_daily_bar_universe_counts_not_all_a_shares",
    "default_reader_rule": "ordinary_reader_may_load_only_a_COMMITTED_enabled_route_dataset_or_explicit_enabled_partition_set_whose_selected_coverage_state_is_OBSERVED_DAILY_BAR_COVERAGE",
    "partial_or_unresolved_rule": "partial_or_unresolved_selection_is_not_automatically_readable_and_requires_a_future_explicit_diagnostic_contract"
  },
  "replay_and_idempotency_contract": {
    "identity_fields": [
      "contract_version",
      "target_dataset",
      "target_window_start",
      "target_window_end",
      "research_split_windows",
      "source_snapshot_id",
      "source_snapshot_as_of",
      "source_snapshot_manifest_hash",
      "source_snapshot_semantic_hash",
      "source_canonical_run_id",
      "source_readmodel_contract_version",
      "identity_view_version",
      "identity_view_hash",
      "identity_source_kind",
      "identity_source_lineage_hash",
      "schema_version",
      "price_basis",
      "universe_basis",
      "coverage_policy_version",
      "partition_policy_version",
      "build_code_fingerprint"
    ],
    "canonical_json_rule": "UTF-8 JSON with sorted keys, compact separators, and no wall-clock fields",
    "idempotency_key_formula": "sha256(canonical_json(materialization_identity))",
    "materialization_id_formula": "rhm-<full_lowercase_idempotency_key>",
    "same_identity_rule": "reverify_all_existing_manifest_inventory_and_partition_bytes; exact bytes return IDEMPOTENT_REPLAY without overwrite",
    "same_id_different_bytes_rule": "MATERIALIZATION_IDENTITY_CONFLICT and fail closed; never last-write-wins",
    "different_identity_rule": "publish_to_a_distinct_deterministic_materialization_id_and_preserve_prior_artifacts",
    "timestamp_rule": "build_timestamp_is_provenance_only_and_never_part_of_identity_or_output_hash"
  },
  "staging_and_failure_atomicity": {
    "staging_path_template": "research_security_daily/.staging/<materialization_id>/",
    "publication_marker": "_SUCCESS.json",
    "publication_marker_rule": "the_marker_records_the_committed_manifest_hash_and_is_written_only_after_every_partition_inventory_and_aggregate_seal_verifies",
    "visibility_rule": "readers_must_ignore_staging_and_any_materialization_without_a_valid_committed_marker",
    "write_order": [
      "verify_single_source_snapshot_and_readmodel",
      "create_deterministic_staging_identity",
      "write_partition_bytes_to_non_published_staging_paths",
      "verify_each_partition_bytes_schema_row_count_semantic_hash_and_primary_keys",
      "write_sorted_partition_inventory",
      "recompute_inventory_and_aggregate_hashes",
      "write_manifest_and_success_marker",
      "atomically_publish_the_manifest_pointer_or_materialization_directory"
    ],
    "failure_rule": "any_failure_leaves_no_new_readable_materialization_and_does_not_modify_a_prior_committed_materialization",
    "resume_rule": "a_future_resume_may_reuse_only_same_identity_staging_parts_after_reverification; it_must_not_change_source_snapshot_split_policy_or_code_identity",
    "stale_staging_rule": "stale_or_identity_conflicting_staging_is_not_resumed_and_is_not_readable",
    "no_partial_commit_rule": "a_manifest_with_missing_partition_inventory_or_a_missing_success_marker_is_not_a_published_dataset"
  },
  "evidence_contract": {
    "manifest_required_fields": [
      "dataset_name",
      "contract_version",
      "materialization_id",
      "idempotency_key",
      "target_window",
      "research_split_windows",
      "source_snapshot_id",
      "source_snapshot_as_of",
      "source_snapshot_manifest_hash",
      "source_snapshot_semantic_hash",
      "source_canonical_run_id",
      "source_readmodel_contract_version",
      "identity_view_version",
      "identity_view_hash",
      "identity_source_kind",
      "identity_source_lineage_hash",
      "schema_version",
      "price_basis",
      "universe_basis",
      "coverage_state",
      "partition_policy_version",
      "coverage_policy_version",
      "build_code_fingerprint",
      "build_timestamp",
      "partition_inventory",
      "partition_inventory_hash",
      "artifact_set_hash",
      "content_hash",
      "publication_state"
    ],
    "partition_inventory_fields": [
      "route",
      "research_split",
      "calendar_year",
      "calendar_month",
      "uri",
      "row_count",
      "enabled_row_count",
      "disabled_row_count",
      "byte_size",
      "content_hash",
      "semantic_hash",
      "schema_hash",
      "min_trade_date",
      "max_trade_date",
      "source_snapshot_id",
      "coverage_state"
    ],
    "logical_partition_inventory_fields": [
      "research_split",
      "calendar_year",
      "calendar_month",
      "route_descriptors",
      "enabled_route_coverage_state",
      "diagnostic_route_coverage_states"
    ],
    "hash_rules": {
      "partition_content_hash": "sha256_of_exact_parquet_bytes",
      "partition_semantic_hash": "sha256(canonical_json(sorted_physical_rows))",
      "partition_inventory_hash": "sha256(canonical_json(inventory_sorted_by_route_split_year_month))",
      "artifact_set_hash": "sha256(canonical_json(all_published_artifact_descriptors_sorted_by_uri))",
      "content_hash": "sha256(canonical_json(schema_hash_partition_inventory_hash_artifact_set_hash_coverage_and_semantic_metadata))",
      "hash_inputs_must_exclude": [
        "retrieval_time",
        "filesystem_mtime",
        "temporary_path",
        "credentials",
        "raw_provider_payload"
      ]
    },
    "inventory_rule": "logical_inventory_exactly_matches_the_78_expected_calendar_partitions_and_nested_route_descriptors_exactly_match_each_nonempty_artifact",
    "local_evidence_only": "the design stores hashes_and_metadata_only; it_does_not_authorize_uploading_raw_provider_payload_or_secrets"
  },
