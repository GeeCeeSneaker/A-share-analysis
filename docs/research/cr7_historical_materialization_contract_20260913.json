      "all_six_inclusive_split_boundary_dates_are_assigned_to_the_declared_split",
      "bse_row_is_present_only_in_disabled_route_with_bse_identity_boundary_reason",
      "identity_unresolved_row_is_preserved_only_in_disabled_route",
      "out_of_window_rows_are_not_materialized",
      "expected_logical_partition_inventory_has_78_entries_even_when_fixture_is_sparse",
      "same_materialization_identity_recomputes_the_same_idempotency_key_and_inventory_hash",
