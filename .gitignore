# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/

# Virtual environments
.venv/
venv/

# Secrets - real credentials never enter git
.env
*.token
*.secret

# Broker SDK distribution hygiene (audit P1-18): wheels never enter git
vendor/
*.whl

# All local data (raw/canonical/features/db/spike outputs) - not a system of record in git
# EXCEPT the golden truth dataset (versioned evidence, audit R4-P0-01)
data/*
!data/golden/

# DuckDB database files
*.duckdb
*.duckdb.wal
*.duckdb.tmp/

# IDE
.idea/
.vscode/
*.swp

# CodeBuddy IDE-managed project data (local, not source)
.codebuddy/

# OS
Thumbs.db
.DS_Store
